# Banco PostgreSQL (na Vercel: Storage > Neon/Supabase Postgres preenche isso sozinho)
DATABASE_URL=postgres://usuario:senha@host:5432/regulasus

# Chave de assinatura das sessões (obrigatória em produção). Gere com: openssl rand -base64 32
AUTH_SECRET=

# IA: na Vercel use o AI Gateway (AI_GATEWAY_API_KEY) ou deixe o OIDC automático do projeto.
AI_GATEWAY_API_KEY=

# --- Acesso provisório (demonstração) ---
# EM PRODUÇÃO O CÓDIGO É OBRIGATÓRIO: sem ele o perfil fica indisponível.
# Perfis regulador e unidade:
PROVISIONAL_ACCESS_CODE=
# Perfil gestor (auditoria) — use um código diferente:
PROVISIONAL_GESTOR_CODE=
# "off" desativa o acesso provisório por completo.
PROVISIONAL_ACCESS=on

# --- Login gov.br (Login Único) — só funciona após adesão formal do órgão ---
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
# Homologação: https://sso.staging.acesso.gov.br | Produção: https://sso.acesso.gov.br
GOVBR_ISSUER=https://sso.staging.acesso.gov.br
# URL pública do app (para montar o redirect_uri: <APP_URL>/api/auth/govbr/callback)
APP_URL=http://localhost:3000
# CPFs (só números, separados por vírgula) autorizados por perfil
GOVBR_REGULADOR_CPFS=
GOVBR_GESTOR_CPFS=
